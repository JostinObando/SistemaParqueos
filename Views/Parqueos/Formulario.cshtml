@model SistemaParqueos.Models.Entidades.PRQParqueos

@{
    var editar = Model.Id > 0;
    ViewData["Title"] = editar ? "Editar parqueo" : "Nuevo parqueo";
}

<h2 class="mb-4">
    @(editar ? "Editar parqueo" : "Registrar parqueo")
</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Guardar" method="post">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre"
                           class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="Provincia" class="form-label"></label>
                    <input asp-for="Provincia"
                           class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="PrecioPorHora" class="form-label">
                        Precio por hora (₡)
                    </label>
                    <input asp-for="PrecioPorHora"
                           type="number" step="0.01" min="0.01"
                           class="form-control" required />
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-primary">Guardar</button>
                <a asp-action="Index"
                   class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
