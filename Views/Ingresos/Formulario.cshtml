@model SistemaParqueos.Models.Formularios.IngresoFormulario

@{
    var editar = Model.Consecutivo > 0;
    ViewData["Title"] = editar ? "Editar ingreso" : "Registrar ingreso";
}

<h2 class="mb-4">
    @(editar ? "Editar ingreso o registrar salida" : "Registrar ingreso")
</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Guardar" method="post">

            <input type="hidden" asp-for="Consecutivo" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="IdAutomovil" class="form-label">
                        Automóvil
                    </label>

                    <select asp-for="IdAutomovil"
                            asp-items="ViewBag.Automoviles"
                            class="form-select" required>
                        <option value="">Seleccione automóvil</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="IdParqueo" class="form-label">
                        Parqueo
                    </label>

                    <select asp-for="IdParqueo"
                            asp-items="ViewBag.Parqueos"
                            class="form-select" required>
                        <option value="">Seleccione parqueo</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaHoraEntrada" class="form-label">
                        Fecha y hora de entrada
                    </label>

                    <input asp-for="FechaHoraEntrada"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           type="datetime-local"
                           class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaHoraSalida" class="form-label">
                        Fecha y hora de salida
                    </label>

                    <input asp-for="FechaHoraSalida"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           type="datetime-local"
                           class="form-control" />

                    <div class="form-text">
                        Deje vacío si el vehículo aún no ha salido.
                    </div>
                </div>

            </div>

            <div class="mt-4">
                <button class="btn btn-primary">Guardar</button>
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>
            </div>

        </form>
    </div>
</div>
